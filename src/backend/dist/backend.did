type TransformArgs = 
 record {
   context: blob;
   response: HttpResponsePayload;
 };
type PersonType = 
 variant {
   JIG;
   NSQF;
 };
type PersonInput = 
 record {
   course: opt text;
   faceDescriptor: vec float64;
   name: text;
   nsqfLevel: opt text;
   personType: PersonType;
   rollNo: opt text;
   semester: opt text;
 };
type Person = 
 record {
   course: opt text;
   faceDescriptor: vec float64;
   id: text;
   name: text;
   nsqfLevel: opt text;
   personType: PersonType;
   rollNo: opt text;
   semester: opt text;
 };
type HttpResponsePayload = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type HttpHeader = 
 record {
   name: text;
   value: text;
 };
type AttendanceUpdateInput = 
 record {
   afterBreak: opt text;
   breakTime: opt text;
   entry: opt text;
   exit: opt text;
 };
type AttendanceRecord = 
 record {
   afterBreak: opt text;
   breakTime: opt text;
   date: text;
   entry: opt text;
   exit: opt text;
   id: text;
   personId: text;
 };
service : {
  addPerson: (input: PersonInput) -> (variant {
                                        err: text;
                                        ok: Person;
                                      });
  clearAllData: () -> ();
  deleteAttendance: (id: text) -> (variant {
                                     err: text;
                                     ok;
                                   });
  deletePerson: (id: text) -> (variant {
                                 err: text;
                                 ok;
                               });
  getActiveMonths: () -> (nat) query;
  getAllFaceDescriptors: () -> (vec record {
                                      text;
                                      vec float64;
                                    }) query;
  getAttendance: (personId: text, date: text) -> (opt AttendanceRecord) query;
  getPerson: (id: text) -> (opt Person) query;
  getTodayCheckIns: () -> (nat) query;
  getTotalCheckIns: () -> (nat) query;
  getTotalStudents: () -> (nat) query;
  listAttendance: () -> (vec AttendanceRecord) query;
  listAttendanceByDate: (date: text) -> (vec AttendanceRecord) query;
  listPersons: () -> (vec Person) query;
  recordAttendance: (personId: text, date: text, slot: text, time: text) ->
   (variant {
      err: text;
      ok: text;
    });
  syncAttendanceWithJwt: (jwt: text, rowDataJson: text, sheetTabName:
   text) -> (text);
  testGoogleSheetsSync: (jwt: text) -> (text);
  transformBatchUpdateResponse: (raw: TransformArgs) ->
   (HttpResponsePayload) query;
  transformSheetsResponse: (raw: TransformArgs) ->
   (HttpResponsePayload) query;
  transformTokenResponse: (raw: TransformArgs) -> (HttpResponsePayload) query;
  updateAttendance: (id: text, updates: AttendanceUpdateInput) ->
   (variant {
      err: text;
      ok: AttendanceRecord;
    });
  updatePerson: (id: text, input: PersonInput) ->
   (variant {
      err: text;
      ok: Person;
    });
}
